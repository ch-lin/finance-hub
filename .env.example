# =============================================================================
# This file contains environment variables for configuring the Docker Compose setup.
# It should not be committed to version control if it contains sensitive data.
# Instead, create a .env.example file with placeholder values.
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
# Password for the 'root' user within the MySQL database container.
# This is used for administrative tasks inside the container, like the healthcheck.
MYSQL_ROOT_PASSWORD=

# The username for the application's dedicated database user.
# The backend and downloader services will use this to connect to the database.
MYSQL_USER=

# The password for the application's database user.
MYSQL_PASSWORD=

# =============================================================================
# Host Path Mappings (Volumes)
# =============================================================================
# Specifies the directory on the host machine to store the MySQL database data.
# This ensures that your database data persists even if the container is removed.
FINANCE_HUB_DB_DATA_PATH=

# =============================================================================
# Data Import Configuration
# =============================================================================
# Specifies the directory on the host machine containing the HTML files to be analyzed.
# The backend service will read files from this directory mapped to /app/data.
FINANCE_HUB_INPUT_PATH=

# =============================================================================
# Finance Hub Default Configuration
# =============================================================================

# =============================================================================
# Public URLs
# =============================================================================
# The public-facing URL of the frontend, as seen by any browser on the network.
# This is used by the backend services to configure CORS (Cross-Origin Resource Sharing).
CORS_ALLOWED_ORIGIN_PATTERNS="http://localhost:3000"

# =========================================================
# 🟢 Optional
# The default value is defined in docker-compose.yml.
# =========================================================

# =============================================================================
# Service Ports
# =============================================================================
# Defines the external ports on the host machine that map to the internal ports
# of the services running in Docker containers.
# FINANCE_HUB_BACKEND_PORT="8085"
# FINANCE_HUB_DB_PORT="3308"

# The name of the database schema that will be created and used by the application.
# FINANCE_HUB_MYSQL_DATABASE="financehub"

# =============================================================================
# Public Backend Service API URLs
# =============================================================================
# The public-facing URL of the Authentication API. This is passed as a build argument
# to the frontend Docker image so it knows where to send API requests.
# AUTH_SERVICE_API_URL="http://authentication-backend:8080"

# =============================================================================
# Central Logging Configuration (Optional)
# =============================================================================
# Credentials for sending logs to the central logging database (backing-services).
# LOGGING_MYSQL_USER="logger"
# LOGGING_MYSQL_PASSWORD=

# =============================================================================
# Environment Configuration
# =============================================================================
# Specifies the environment file to load for service configuration (e.g., .env.base, .env.dev).
# This is used in docker-compose.yml to dynamically include the correct env file.
# APP_ENV_FILE=".env.dev"
