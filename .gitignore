# =================================
# OS-generated files
# =================================
.DS_Store
Thumbs.db

# =================================
# IDE & Editor specific
# =================================
.idea/
.vscode/
.project
.classpath
.settings
*.iml

# =================================
# Security & Local Config (CRITICAL)
# =================================
# 1. Ignore all env files
.env
.env.*
*.env

# 2. Whitelist shared/template env files (Do NOT ignore these)
!.env.example
!.env.base
!.env.dev
!.env.prod

# 3. Certificates & Keys
**/certs/private.pem
*.key
*.pem

# 4. Sample Data
data/

# =================================
# Java / Backend (Maven/Gradle)
# =================================
# Compiled output
target/
/build/
/bin/
*.class

# Package Files
*.jar
*.war
*.ear

# Log files
*.log

# virtual machine crash logs
hs_err_pid*

# Runner
*Runner.java

# =================================
# Node.js / Frontend (Next.js)
# =================================
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

