FINANCE_HUB_TRANSACTION_SOURCE_CONFIGS_AMAZON_ENABLED="true"
FINANCE_HUB_TRANSACTION_SOURCE_CONFIGS_AMAZON_AUTO_START_SCHEDULER="false"
